# Copy to .env to override defaults (all optional). Never commit a real .env.
# Every Settings field in backend/app/config.py can be overridden as SLRAG_<FIELD>.

# Retrieval / reranking
SLRAG_USE_RERANKER=true
SLRAG_TOP_K=8
SLRAG_FINAL_EVIDENCE_K=8

# Controller: learned (default) or rule (ablation baseline)
SLRAG_CONTROLLER_MODE=learned

# Optional LLM synthesis (off by default; answers are extractive and cost $0).
# If enabled, every LLM sentence still passes the grounding validator.
SLRAG_LLM_PROVIDER=none
SLRAG_LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=            # set in your shell / secret store, not in this file
